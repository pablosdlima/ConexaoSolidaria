<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["WebApp.styles.css"]" />
    <ImportMap />
    <HeadOutlet @rendermode="InteractiveAuto" />
</head>

<body>
    @* Interatividade GLOBAL (modo Auto).
       Sem isto o AppLayout renderiza estatico e o <AuthorizeView> tenta ler o
       localStorage no servidor, onde JS interop nao existe. *@
    <Routes @rendermode="InteractiveAuto" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    // Prerender LIGADO: o servidor entrega a pagina ja preenchida (o painel publico nao
    // exige login). A sessao vive no localStorage, que nao existe no servidor — por isso
    // o TokenStore devolve "sem token" nessa janela e o AppLayout reavalia em
    // OnAfterRenderAsync, quando o navegador assume.
    private static readonly InteractiveAutoRenderMode InteractiveAuto = new(prerender: true);
}
