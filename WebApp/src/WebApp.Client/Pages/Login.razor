@page "/login"
@rendermode @(new InteractiveAutoRenderMode(prerender: false))
@inject AuthService Auth
@inject NavigationManager Nav

<PageTitle>Entrar - Conexao Solidaria</PageTitle>

<div class="formulario-centro">
    <h1>Entrar</h1>

    <EditForm Model="modelo" OnValidSubmit="Entrar" FormName="login">
        <DataAnnotationsValidator />

        <label>
            E-mail
            <InputText @bind-Value="modelo.Email" type="email" autocomplete="username" />
            <ValidationMessage For="() => modelo.Email" />
        </label>

        <label>
            Senha
            <InputText @bind-Value="modelo.Senha" type="password" autocomplete="current-password" />
            <ValidationMessage For="() => modelo.Senha" />
        </label>

        @if (erro is not null)
        {
            <div class="alerta alerta-erro">@erro</div>
        }

        <button class="botao botao-bloco" type="submit" disabled="@enviando">
            @(enviando ? "Entrando..." : "Entrar")
        </button>
    </EditForm>

    <p class="rodape-formulario">
        Nao tem conta? <a href="/cadastro">Cadastre-se como doador</a>.
    </p>

    <details class="dica-demo">
        <summary>Credenciais de demonstracao</summary>
        <p>Gestor: <code>gestor@esperancasolidaria.org</code> / <code>Gestor@123</code></p>
        <p>Doador: cadastre um novo, ou <code>joao@exemplo.com</code> / <code>Senha@123</code></p>
    </details>
</div>

@code {
    private readonly LoginModelo modelo = new();
    private string? erro;
    private bool enviando;

    private async Task Entrar()
    {
        enviando = true;
        erro = null;

        var r = await Auth.LoginAsync(modelo.Email, modelo.Senha);

        if (r.Sucesso && r.Dados is not null)
        {
            // Gestor cai na gestao de campanhas; doador, no painel publico.
            Nav.NavigateTo(r.Dados.Role == "GestorONG" ? "/campanhas" : "/");
        }
        else
        {
            erro = r.Erro;
            enviando = false;
        }
    }

    private sealed class LoginModelo
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Informe o e-mail.")]
        [System.ComponentModel.DataAnnotations.EmailAddress(ErrorMessage = "E-mail invalido.")]
        public string Email { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Informe a senha.")]
        public string Senha { get; set; } = "";
    }
}
